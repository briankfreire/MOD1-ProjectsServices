# Configure separately from the identity service. Never copy its private key here.
# Neon: use a projects-only runtime role; admin URL only for explicit init/migrate.
DATABASE_URL=postgresql+psycopg://PROJECTS_USER:CHANGE_ME@HOST/DATABASE?sslmode=verify-full&sslrootcert=C:/PATH/TO/TRUSTED/CA.pem
DATABASE_SCHEMA=projects
JWT_ISSUER=mod1-auth-local
JWT_AUDIENCE=engenharia-software-api
JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
CORS_ORIGINS=["http://127.0.0.1:5173"]

# Authoritative current account/session state (keep enabled in runtime).
AUTH_API_BASE_URL=http://127.0.0.1:8000
AUTH_SESSION_CHECK_ENABLED=true
BACKLOG_API_BASE_URL=http://127.0.0.1:8002
# AI_BASE_URL is intentionally unset: no provider requests by default.
AI_PROVIDER=structured-http
# AI_BASE_URL=https://YOUR_AUTHORIZED_PROVIDER
AI_MODEL=unconfigured
AI_SIMULATED=false
ACCESS_INACTIVITY_DAYS=30
# AI_API_KEY is an environment-only secret; never put real credentials in Git.
# Explicit backend-only opt-in: AI_PROVIDER=gemini. Keep AI_SIMULATED=false.
# GEMINI_API_KEY=configure-only-in-private-environment
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional project curation. The production base is fixed; tests may use HTTP loopback.
MODULE5_ENABLED=false
MODULE5_BASE_URL=https://agente-tendencias-tecnologicas-fyd3bzerc9a2cqcu.chilecentral-01.azurewebsites.net

# Read-only Module 3 artifacts, explicit project association; no upstream credentials.
MODULE3_ENABLED=false
MODULE3_BASE_URL=https://modulo3-fhgjdpa6d5bbfvff.canadacentral-01.azurewebsites.net

# Optional Module 6 delivery: private backend key and explicit worker required.
MODULE6_ENABLED=false
# MODULE6_KEY: configure only in private environment / Azure secret reference.
# Module 1 deployment convention; keep the integration disabled until configured.
# MODULE6_SOURCE=backlog
