# Configure separately from the identity service. Never copy its private key here.
# Neon: use a projects-only runtime role; admin URL only for explicit init/migrate.
DATABASE_URL=postgresql+psycopg://PROJECTS_USER:CHANGE_ME@HOST/DATABASE?sslmode=verify-full&sslrootcert=C:/PATH/TO/TRUSTED/CA.pem
DATABASE_SCHEMA=projects
JWT_ISSUER=mod1-auth-local
JWT_AUDIENCE=engenharia-software-api
JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
CORS_ORIGINS=["http://127.0.0.1:5173"]
